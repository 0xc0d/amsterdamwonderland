---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { t, localePath, locales, type Locale } from "../i18n";
import { buildGraph, type Crumb, type FaqItem } from "../lib/seo";
import type { WorkshopSlug } from "../lib/pricing";

interface Props {
  locale: Locale;
  /** Locale-agnostic path, e.g. "/workshops" or "/". Used for hreflang + the switcher. */
  path: string;
  title: string;
  description: string;
  /** Extra schema.org type for this page, e.g. "AboutPage", "CollectionPage". */
  pageType?: string;
  /** Trail for the BreadcrumbList. Home is prepended automatically. */
  crumbs?: Crumb[];
  /** Questions shown on the page; the same array becomes the FAQPage markup. */
  faq?: FaqItem[];
  /** Set on a workshop's own page so its Service and Offer are emitted. */
  workshopSlug?: WorkshopSlug;
}

const {
  locale,
  path,
  title,
  description,
  pageType,
  crumbs = [],
  faq,
  workshopSlug,
} = Astro.props;

const dict = t(locale);
const site = Astro.site?.toString().replace(/\/$/, "") ?? "";
const canonical = site + localePath(locale, path);

/* Locale-specific preview cards: the Dutch one reads KUNSTWORKSHOPS. Generated
   by scripts/make-og.py. Both used to be a single /og.png that did not exist. */
const ogImage = `${site}${locale === "nl" ? "/og-nl.png" : "/og.png"}`;

/* Home is always the first crumb, and the current page never gets a URL, which
   is how Google expects the last item in a trail. */
const trail: Crumb[] =
  crumbs.length > 0 ? [{ name: dict.nav.home, path: "/" }, ...crumbs] : [];

/* One @graph per page, replacing the old single LocalBusiness object that only
   the two home pages emitted. */
const graph = buildGraph({
  site,
  locale,
  canonical,
  title,
  description,
  ogImage,
  pageType,
  crumbs: trail,
  faq,
  workshopSlug,
});
---

<!doctype html>
<html lang={dict.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {locales.map((l) => (
      <link rel="alternate" hreflang={l} href={site + localePath(l, path)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={site + localePath("en", path)} />

    <meta property="og:type" content={path === "/" ? "website" : "article"} />
    <meta property="og:site_name" content="Wonderland Workshops" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale === "nl" ? "nl_NL" : "en_GB"} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale:alternate" content={locale === "nl" ? "en_GB" : "nl_NL"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Explicit, so a stray noindex can never be inherited from a host default. -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0A70BF" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;700;800&family=Instrument+Serif:ital@0;1&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a href="#main" class="skip">Skip to content</a>
    <Header locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <style>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 100;
        background: var(--ink);
        color: var(--paper);
        padding: 0.75rem 1.25rem;
        font-family: var(--font-display);
        font-size: 0.75rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        text-decoration: none;
      }
      .skip:focus { left: 0; }
    </style>
  </body>
</html>
