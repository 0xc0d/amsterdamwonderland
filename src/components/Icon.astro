---
/** Shared icon set. One stroke weight, one grid, one place to change them.
 *  phone/mail are stroked (Feather geometry); whatsapp/instagram are filled
 *  brand marks, which must not be redrawn as strokes. */
interface Props { name: "phone" | "mail" | "whatsapp" | "pin"; size?: string; }
const { name, size = "1.25rem" } = Astro.props;

const filled = name === "whatsapp";
---

<svg
  class:list={["ico", filled && "ico--filled"]}
  style={`width:${size};height:${size}`}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  {name === "phone" && (
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
  )}
  {name === "mail" && (
    <>
      <rect x="2" y="4" width="20" height="16" rx="2" />
      <path d="m2.5 6.5 9.5 6.8 9.5-6.8" />
    </>
  )}
  {name === "pin" && (
    <>
      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
      <circle cx="12" cy="10" r="3" />
    </>
  )}
  {name === "whatsapp" && (
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.347-.347.52-.52.174-.174.232-.298.347-.497.116-.198.058-.371-.03-.52-.086-.148-.66-1.59-.905-2.178-.238-.572-.48-.494-.658-.503-.171-.008-.367-.01-.563-.01-.196 0-.514.073-.783.37-.27.298-1.024 1-1.024 2.442 0 1.44 1.05 2.833 1.196 3.03.148.198 2.066 3.155 5.005 4.425.7.302 1.246.483 1.673.618.712.226 1.36.194 1.872.118.572-.085 1.758-.719 2.006-1.413.248-.694.248-1.29.174-1.414-.075-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
  )}
</svg>

<style>
  .ico {
    flex: none;
    display: block;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ico--filled { fill: currentColor; stroke: none; }
</style>
