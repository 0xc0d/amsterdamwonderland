---
/** Instagram link using the official glyph outline (Simple Icons path data,
 *  CC0). This is the real mark as a single filled path — an earlier hand-drawn
 *  stroked approximation never matched the true proportions. Do not redraw it:
 *  scale it. `fill: currentColor` keeps it monochrome with the design. */
import { INSTAGRAM, INSTAGRAM_HANDLE } from "../lib/config";

interface Props {
  /** Show the @handle beside the glyph (footer, contact page). */
  withHandle?: boolean;
  /** Bordered square matching the header's language pill. */
  boxed?: boolean;
  /** Filled black square with a knocked-out white glyph. */
  solid?: boolean;
  /** Invert the solid square for use on an ink/dark background. */
  onDark?: boolean;
  /** Render the handle as body text (footer/contact lists) rather than as an
   *  uppercase button label (booking bar). */
  plain?: boolean;
  label?: string;
}
const { withHandle = false, boxed = false, solid = false, onDark = false, plain = false, label = "Instagram" } = Astro.props;

const PATH =
  "M7.0301.084c-1.2768.0602-2.1487.264-2.911.5634-.7888.3075-1.4575.72-2.1228 1.3877-.6652.6677-1.075 1.3368-1.3802 2.127-.2954.7638-.4956 1.6365-.552 2.9137-.0564 1.2772-.0689 1.6923-.0626 4.9564.0062 3.264.0206 3.6768.0825 4.9541.061 1.2765.264 2.1482.5635 2.9107.308.7889.72 1.4573 1.388 2.1228.6679.6655 1.3365 1.0743 2.1285 1.38.7632.2952 1.6361.4961 2.9134.552 1.2773.056 1.6923.069 4.9552.0627 3.264-.0062 3.6784-.0207 4.9552-.0814 1.2768-.0607 2.1443-.2652 2.9068-.5633.7889-.3086 1.4578-.72 2.1228-1.3881.665-.6682 1.0745-1.3378 1.3795-2.1284.2957-.7632.4966-1.636.552-2.9124.056-1.2809.0692-1.6961.063-4.9602-.0063-3.2642-.021-3.6765-.0817-4.9532-.0607-1.2767-.264-2.1482-.5633-2.9113-.3084-.7889-.72-1.4568-1.3876-2.1228C21.2982 1.33 20.628.9208 19.8378.6165 19.074.321 18.2017.1197 16.9244.0645 15.6471.0093 15.232-.0044 11.967.0018 8.703.008 8.2911.0224 7.0301.0839m.1402 21.6932c-1.17-.0509-1.8053-.2453-2.2287-.408-.5606-.216-.96-.4771-1.3819-.895-.422-.4178-.6811-.8186-.9-1.378-.1644-.4234-.3624-1.058-.4171-2.228-.0595-1.2645-.072-1.6299-.079-4.8396-.007-3.2096.0053-3.5749.0607-4.8399.05-1.169.2456-1.805.408-2.2282.216-.5613.4762-.96.895-1.3816.4189-.4217.8184-.6814 1.3783-.9003.4228-.1651 1.0574-.3614 2.2267-.4171 1.2655-.06 1.6304-.0724 4.8393-.0795 3.209-.007 3.5752.005 4.8412.0607 1.169.0509 1.8053.2445 2.228.408.5608.216.96.4754 1.3816.895.4217.4194.6816.8176.9005 1.3783.1653.4217.3617 1.056.4169 2.2263.0602 1.2655.0739 1.6308.0796 4.8397.0058 3.2088-.0055 3.5751-.0607 4.8394-.051 1.17-.2452 1.8055-.408 2.2294-.216.5604-.4763.96-.8954 1.3814-.419.4215-.8181.6811-1.3783.9-.4224.1649-1.0577.3617-2.2262.4174-1.2656.0595-1.6309.0724-4.8409.0795-3.2099.007-3.5748-.006-4.8403-.0607M16.953 5.5864A1.44 1.44 0 1 0 18.39 4.144a1.44 1.44 0 0 0-1.437 1.4424M5.8385 12.012c.0067 3.4032 2.7706 6.1557 6.1735 6.1493 3.403-.0065 6.1567-2.7701 6.1502-6.1733-.0065-3.4032-2.771-6.1565-6.1744-6.1498-3.4034.0067-6.1561 2.7707-6.1493 6.1738M8 12.0077a4 4 0 1 1 4.008 3.9921A4 4 0 0 1 8 12.0077";
---

<a
  class:list={["ig", boxed && "ig--boxed", solid && "ig--solid", onDark && "ig--onDark", withHandle && "ig--handle", plain && "ig--plain"]}
  href={INSTAGRAM}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${label}: ${INSTAGRAM_HANDLE}`}
>
  <svg class="ig-glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d={PATH} />
  </svg>
  {withHandle && <span class="ig-handle">{INSTAGRAM_HANDLE}</span>}
</a>

<style>
  .ig {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: inherit;
    text-decoration: none;
    line-height: 1;
    transition: color 0.16s ease, background-color 0.16s ease, border-color 0.16s ease;
  }
  .ig-glyph {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    display: block;
    fill: currentColor;
    stroke: none;
  }

  /* No frame: the mark already contains its own rounded square, so a bordered
     box around it reads as two nested squares. Sized to sit optically level
     with the 2.125rem language pill beside it. */
  .ig--boxed {
    width: 2.125rem;
    height: 2.125rem;
    padding: 0;
    box-sizing: border-box;
  }
  .ig--boxed .ig-glyph { width: 1.5rem; height: 1.5rem; }

  .ig--solid {
    background: var(--ink);
    color: var(--paper);
    width: 2.125rem;
    height: 2.125rem;
    padding: 0;
    box-sizing: border-box;
  }
  /* Knocked out at 20px inside a 34px square: enough ground that the mark
     reads as a mark rather than filling the tile edge to edge. */
  .ig--solid .ig-glyph { width: 1.125rem; height: 1.125rem; }
  .ig--solid:hover { background: var(--pink); }
  /* On an ink background the square must invert or it disappears. */
  .ig--solid.ig--onDark { background: var(--paper); color: var(--ink); }
  .ig--solid.ig--onDark:hover { background: var(--pink); color: var(--paper); }

  .ig-handle {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ig--handle .ig-glyph { width: 1.375rem; height: 1.375rem; }
  /* Sits in a list beside plain phone/email rows, so it must not shout. */
  .ig--plain .ig-handle {
    font-size: var(--step--1);
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
  }
  .ig--plain .ig-glyph { width: 1.05rem; height: 1.05rem; }
  .ig--plain { gap: 0.55rem; }

  .ig:not(.ig--boxed):hover { color: var(--pink); }
  .ig:focus-visible { outline: var(--rule) solid currentColor; outline-offset: 3px; }
</style>
