---
/** The one thing a business needs: how to reach a human. Repeated on every page.
 *  Buttons that lack their number in config.ts are simply not rendered, so the
 *  bar never shows a dead control. */
import InstagramLink from "./InstagramLink.astro";
import Icon from "./Icon.astro";
import { t, type Locale } from "../i18n";
import { EMAIL, PHONE_DISPLAY, telHref, waHref, hasPhone, hasWhatsApp } from "../lib/config";

interface Props { locale: Locale; tone?: "electric" | "paper"; }
const { locale, tone = "electric" } = Astro.props;
const d = t(locale);
---

<section class="shell section">
  <div class:list={["book", tone === "electric" && "book--electric"]}>
    <div class="book-head">
      <h2 class="display-lg book-title">{d.book.title}</h2>
      <p class="book-body">{d.book.body}</p>
    </div>

    <div class="book-actions">
      {hasPhone && (
        <a class="bbtn bbtn--primary" href={telHref}>
          <Icon name="phone" size="1.25rem" />
          <span class="bbtn-t">
            <span class="bbtn-l">{d.book.call}</span>
            <span class="bbtn-v">{PHONE_DISPLAY}</span>
          </span>
        </a>
      )}

      {hasWhatsApp && (
        <a class="bbtn" href={waHref} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" size="1.25rem" />
          <span class="bbtn-t"><span class="bbtn-l">{d.book.whatsapp}</span></span>
        </a>
      )}

      <a class:list={["bbtn", !hasPhone && "bbtn--primary"]} href={`mailto:${EMAIL}`}>
        <Icon name="mail" size="1.25rem" />
        <span class="bbtn-t">
          <span class="bbtn-l">{d.book.email}</span>
          <span class="bbtn-v">{EMAIL}</span>
        </span>
      </a>

      <span class="bbtn bbtn--ig"><InstagramLink withHandle label={d.book.instagram} /></span>
    </div>
  </div>
</section>

<style>
  .book {
    border: var(--rule) solid var(--line);
    padding: clamp(1.5rem, 4vw, 3rem);
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .book--electric {
    background: var(--electric);
    color: var(--paper);
    border-color: var(--electric);
  }
  .book-title { margin: 0; }
  .book-body {
    margin-block-start: var(--s2);
    max-width: 32ch;
    font-size: 1.0625rem;
  }

  .book-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: stretch;
  }

  .bbtn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.125rem;
    border: var(--rule) solid currentColor;
    color: inherit;
    text-decoration: none;
    min-height: 3.25rem;
    transition: background 0.15s, color 0.15s;
  }
  /* The primary action is the one we most want a business to press. */
  .bbtn--primary {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  .book:not(.book--electric) .bbtn--primary {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .bbtn:hover { background: var(--pink); color: var(--paper); border-color: var(--pink); }
  .bbtn:focus-visible { outline: var(--rule) solid currentColor; outline-offset: 3px; }
  .bbtn--ig { padding-inline: 1.125rem; }
  .bbtn--ig:hover { background: none; border-color: currentColor; color: inherit; }

  .bico {
    width: 1.5rem; height: 1.5rem; flex: none;
    fill: none; stroke: currentColor; stroke-width: 1.8;
    stroke-linecap: round; stroke-linejoin: round;
  }
  .bico .wa-in, .bico .ml-in { stroke-width: 1.6; }

  .bbtn-t { display: grid; gap: 0.1rem; min-width: 0; }
  .bbtn-l {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.1;
  }
  /* The actual number/address, so it can be read or copied without a click. */
  .bbtn-v {
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.2;
    overflow-wrap: anywhere;
    word-break: normal;
    opacity: 0.85;
  }

  @media (min-width: 900px) {
    .book { grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); align-items: center; }
  }
  @media (max-width: 480px) {
    .book-actions { display: grid; grid-template-columns: 1fr; }
  }
</style>
