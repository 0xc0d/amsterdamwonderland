---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import BookingBar from "../BookingBar.astro";
import Faq from "../Faq.astro";
import { t, localePath, type Locale } from "../../i18n";
import { getWorkshops, priceLabel, type Workshop, type WorkshopImage } from "../../content/workshops";
import { workshopFaq } from "../../content/faq";
import { MIN_GROUP, STUDIO_CAPACITY, MODEL_FEE } from "../../lib/pricing";

import totes from "../../assets/merchandise-totes.png";
import lifeDrawing from "../../assets/life-drawing.jpg";
import lifeModelSetup from "../../assets/life-model-setup.jpg";
import ink from "../../assets/mixed-media-ink.jpg";
import collage from "../../assets/mixed-media-collage.jpg";
import paintingsFloor from "../../assets/w-paintings-floor.jpg";
import hoodedPortrait from "../../assets/w-hooded-portrait.jpg";
import studioSession from "../../assets/w-studio-session.jpg";

/* Must cover every value in WorkshopImage — a missing key silently drops the
   image, because `images[w.image]` is then undefined and the block never renders. */
const images: Record<WorkshopImage, ImageMetadata> = {
  "merchandise-totes": totes,
  "life-drawing": lifeDrawing,
  "life-model-setup": lifeModelSetup,
  "mixed-media-ink": ink,
  "mixed-media-collage": collage,
  "w-paintings-floor": paintingsFloor,
  "w-hooded-portrait": hoodedPortrait,
  "w-studio-session": studioSession,
};

interface Props { locale: Locale; workshop: Workshop; }
const { locale, workshop: w } = Astro.props;
const d = t(locale);
const key = w.heroImage ?? w.image;
const img = key ? images[key] : null;
const others = getWorkshops(locale).filter((x) => x.slug !== w.slug);
const faq = workshopFaq(locale, w.slug);

/* The searchable title lives on the workshop record, not here: appending a
   location suffix to the artistic title ran to 66 characters and got truncated
   in the result. See metaTitle in src/content/workshops.ts. */

/* The hero image alt used to be just `w.title`, which told Google Images nothing
   the <h1> did not already say. */
const heroAlt = locale === "nl"
  ? `${w.title}: kunstworkshop in het atelier van Wonderland Workshops in Amsterdam`
  : `${w.title}: art workshop in the Wonderland Workshops atelier in Amsterdam`;
---

<Base
  locale={locale}
  path={`/workshops/${w.slug}`}
  title={w.metaTitle}
  description={w.metaDescription}
  crumbs={[{ name: d.nav.workshops, path: "/workshops" }, { name: w.title }]}
  workshopSlug={w.slug}
  faq={faq}
>
  <article>
    <header class="shell head">
      <a class="back small" href={localePath(locale, "/workshops")}>← {d.workshopsPage.allWorkshops}</a>
      <h1 class="display-lg">{w.title}</h1>
      <p class="lead tag">{w.tagline}</p>
    </header>

    {img && (
      <div class="shell">
        <Image src={img} alt={heroAlt} class="ratio-169 hero-img" widths={[700, 1200, 1800]}
               sizes="(max-width: 900px) 100vw, 1400px" loading="eager" />
      </div>
    )}

    <div class="shell section--tight grid12">
      <div class="facts">
        <dl class="stack">
          <div class="fact">
            <dt class="eyebrow muted">{d.workshopsPage.duration}</dt>
            <dd>{w.duration}</dd>
          </div>
          <div class="fact">
            <dt class="eyebrow muted">{d.workshopsPage.format}</dt>
            <dd>{w.format}</dd>
          </div>
          <div class="fact">
            <dt class="eyebrow muted">{d.workshopsPage.groupSize}</dt>
            <dd>{d.about.capacity}</dd>
          </div>
          <div class="fact">
            <dt class="eyebrow muted">{d.workshopsPage.price}</dt>
            <dd>
              {priceLabel(locale, w.slug)}
              {w.slug === "life-drawing" && <><br /><span class="small muted">+ €{MODEL_FEE} {d.estimate.modelFeeLabel.toLowerCase()}</span></>}
              {w.slug === "custom" && <><br /><span class="small muted">{d.workshopsPage.customPriceNote}</span></>}
            </dd>
          </div>
        </dl>
        {w.slug !== "custom" && (
          <div class="row acts">
            <a class="btn btn--ghost" href={localePath(locale, "/estimate")}>{d.workshopsPage.estimateThis}</a>
          </div>
        )}
      </div>

      <div class="body">
        <p class="intro">{w.intro}</p>
        <div class="prose">
          {w.body.map((para) => <p>{para}</p>)}
        </div>

        <div class="rule outcomes">
          <p class="eyebrow acc">{d.workshopsPage.takeaway}</p>
          <ul class="olist">
            {w.outcomes.map((o) => <li>{o}</li>)}
          </ul>
        </div>

        {w.notes && w.notes.length > 0 && (
          <div class="rule notes">
            <p class="eyebrow muted">{d.workshopsPage.goodToKnow}</p>
            <ul class="stack-sm">
              {w.notes.map((n) => <li class="small muted">{n}</li>)}
            </ul>
          </div>
        )}
      </div>
    </div>

    <Faq eyebrow={d.workshopsPage.faqEyebrow} title={d.workshopsPage.faqTitle} items={faq} />

    <section class="shell section">
      <div class="rule">
        <p class="eyebrow acc">{d.workshopsPage.allWorkshops}</p>
      </div>
      <ul class="others">
        {others.map((o) => (
          <li>
            <a class="other" href={localePath(locale, `/workshops/${o.slug}`)}>
              <span class="display-md">{o.title}</span>
              <span class="small muted">{priceLabel(locale, o.slug)}</span>
              <span class="arrow">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </article>
  <BookingBar locale={locale} />
</Base>

<style>
  .head { padding-block-start: clamp(1.5rem, 4vw, 3rem); display: grid; gap: var(--s2); }
  .back { text-decoration: none; color: var(--ink-soft); }
  .back:hover { color: var(--pink); }
  .idx { color: var(--electric); }
  .tag { color: var(--pink); max-width: 30ch; }
  .hero-img { margin-block-start: var(--s3); border: var(--rule) solid var(--line); }

  .facts { grid-column: span 4; }
  .body  { grid-column: 6 / span 7; display: grid; gap: var(--s4); }
  @media (max-width: 800px) {
    .facts { grid-column: span 6; }
    .body  { grid-column: 1 / -1; }
  }

  .fact { border-top: var(--rule) solid var(--line); padding-block-start: 0.7rem; }
  .fact dd { font-size: var(--step-0); margin-block-start: 0.35rem; }
  .acts { margin-block-start: var(--s4); }

  .intro { font-family: var(--font-accent); font-size: var(--step-2); line-height: 1.3; }
  .acc { color: var(--electric); }
  .olist { display: grid; gap: 0.7rem; margin-block-start: var(--s2); }
  .olist li { padding-inline-start: 1.4rem; position: relative; }
  .olist li::before {
    content: "→"; position: absolute; left: 0; color: var(--electric); font-weight: 700;
  }
  .notes ul { margin-block-start: var(--s2); }

  .others { margin-block-start: var(--s3); display: grid; }
  .other {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 2rem;
    align-items: center;
    gap: var(--s2);
    padding-block: var(--s3);
    border-bottom: var(--rule) solid var(--line);
    text-decoration: none;
    transition: background-color .16s ease, padding-inline .16s ease;
  }
  .other:hover { background: var(--periwinkle); padding-inline: var(--s2); }
  .other > .display-md { min-width: 0; }
  .other > .small { white-space: nowrap; }
  .arrow { text-align: right; color: var(--electric); }
  @media (max-width: 640px) {
    .other { grid-template-columns: minmax(0, 1fr) auto; }
    .arrow { display: none; }
  }
</style>
