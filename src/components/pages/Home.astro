---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import WorkshopCard from "../WorkshopCard.astro";
import BookingBar from "../BookingBar.astro";
import Faq from "../Faq.astro";
import { t, localePath, type Locale } from "../../i18n";
import { getWorkshops } from "../../content/workshops";
import { generalFaq } from "../../content/faq";

import hero from "../../assets/hero-collage.png";
import participant from "../../assets/participant-drawing.jpg";
import food from "../../assets/food-spread.jpg";
import ink from "../../assets/mixed-media-ink.jpg";
import collage from "../../assets/mixed-media-collage.jpg";
import totes from "../../assets/merchandise-totes.png";
import groupLaughing from "../../assets/group-laughing.jpg";
import concentrationPair from "../../assets/concentration-pair.jpg";

interface Props { locale: Locale; }
const { locale } = Astro.props;
const d = t(locale);
const workshops = getWorkshops(locale);
const faq = generalFaq(locale);

/* The old 11vw cap on the H1 existed because "WORKSHOPS" is a single
   unbreakable word wider than a 390px viewport at --step-5. The H1 is now a
   phrase, and the Dutch one contains "KUNSTWORKSHOPS" at 14 characters, so the
   cap is derived from the longest word rather than hard-coded. 136 approximates
   the usable width in vw divided by the cap-height advance of Archivo 800, and
   it is clamped to the old 11vw so English never renders larger than before. */
const longestWord = Math.max(...d.home.heroTitle.split(/\s+/).map((w) => w.length));
const titleCap = `${Math.min(11, Math.round(1360 / longestWord) / 10)}vw`;
---

<Base
  locale={locale}
  path="/"
  title={d.home.metaTitle}
  description={d.home.metaDescription}
  faq={faq}
>
  <!-- ============ HERO — Marie & Mette's own words, in their order ============ -->
  <section class="shell hero">
    <h1 class="display-xl htitle" style={`--h1-cap:${titleCap}`}>{d.home.heroTitle}</h1>

    <div class="hero-art">
      <Image
        src={hero}
        alt={locale === "nl" ? "Wonderland Workshops: collage van een figuur met de naam van het atelier eroverheen" : "Wonderland Workshops: cut-out collage of a figure with the studio name across it"}
        widths={[600, 1000, 1600, 2000]}
        sizes="(max-width: 900px) 100vw, 1400px"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <p class="lead hero-lead">{d.home.heroLead}</p>

    <div class="hero-copy">
      <p class="claim">{d.home.heroClaim}</p>
      <div class="stack">
        <p>{d.home.heroBody}</p>
        <a class="btn btn--solid" href={localePath(locale, "/workshops")}>{d.home.ctaPrimary}</a>
      </div>
    </div>
  </section>

  <!-- ============ BOOK — put the phone number near the top ============ -->
  <BookingBar locale={locale} />

  <!-- ============ WORKSHOPS ============ -->
  <section class="shell section">
    <div class="rule between">
      <p class="eyebrow acc">{d.home.workshopsEyebrow}</p>
      <p class="small muted">{d.home.workshopsNote}</p>
    </div>

    <div class="cards cards--after-rule">
      {workshops.map((w) => <WorkshopCard workshop={w} locale={locale} />)}
    </div>
  </section>

  <!-- ============ NO EXPERIENCE — their words ============ -->
  <section class="shell section">
    <div class="rule">
      <h2 class="display-lg">{d.home.introTitle}</h2>
      <div class="twocol">
        <p>{d.home.introA}</p>
        <p>{d.home.introB}</p>
      </div>
    </div>

    <div class="trio">
      <Image src={participant} alt={locale === "nl" ? "Twee deelnemers lachen met een tekening uit de workshop in Amsterdam" : "Two participants laughing while holding up a drawing made in the workshop"} class="ratio-43" widths={[400,700,1100]} loading="lazy" />
      <Image src={food} alt={locale === "nl" ? "Fruit en groenten klaargezet voor de slow juice tijdens een workshop" : "Fruit and vegetables prepared for the slow juice served during a workshop"} class="ratio-43" widths={[400,700,1100]} loading="lazy" />
      <Image src={concentrationPair}
             alt={locale === "nl" ? "Twee deelnemers tekenen samen aan de tafel" : "Two participants drawing together at the table"}
             class="ratio-43" widths={[400,700,1100]} loading="lazy" />
    </div>
  </section>

  <!-- ============ GALLERY PREVIEW ============ -->
  <section class="shell section">
    <div class="rule between">
      <p class="eyebrow acc">{d.home.galleryEyebrow}</p>
      <a class="btn btn--ghost" href={localePath(locale, "/gallery")}>{d.home.galleryMore}</a>
    </div>
    <div class="gal section--tight">
      <Image src={collage} alt={locale === "nl" ? "Collage van tijdschriftpapier gemaakt in de mixed media-workshop" : "A magazine collage made in the mixed media art workshop in Amsterdam"} class="ratio-45" widths={[400,800]} loading="lazy" />
      <Image src={ink} alt={locale === "nl" ? "Inktportret in de maak tijdens een kunstworkshop in het atelier" : "An ink portrait in progress during an art workshop in the atelier"} class="ratio-45" widths={[400,800]} loading="lazy" />
      <Image src={groupLaughing}
             alt={locale === "nl" ? "Een groep lacht tijdens een workshop" : "A group laughing during a workshop"}
             class="ratio-45" widths={[400,800]} loading="lazy" />
      <Image src={totes} alt={locale === "nl" ? "Linnen tassen gezeefdrukt in de merch-workshop" : "Tote bags silk screened in the make your own merch workshop"} class="ratio-45" widths={[400,688]} loading="lazy" />
    </div>
  </section>

  <!-- ============ FAQ — the phrasings people actually search ============ -->
  <Faq eyebrow={d.home.faqEyebrow} title={d.home.faqTitle} items={faq} />
</Base>

<style>
  /* Small gap: the eyebrow row above belongs to these cards. It used to carry
     section--tight, stacking a second full section margin under the rule. */
  .cards--after-rule { margin-block-start: var(--s3); }
  /* Hero */
  .hero { padding-block-start: clamp(2rem, 5vw, 4rem); }
  /* The longest word in the H1 must fit a 390px viewport, or the primary
     keyword gets hyphenated across two lines. --h1-cap is computed per locale
     in the frontmatter; on desktop --step-5 is the smaller value and wins. */
  .htitle {
    margin-block-start: 0;
    font-size: min(var(--step-5), var(--h1-cap, 11vw));
  }
  .hero-art {
    margin-block-start: clamp(1.25rem, 3vw, 2rem);
    border: var(--rule) solid var(--line);
    /* Matches the artwork's own background so the image reads as one field. */
    background: var(--electric);
  }
  /* Cap the artwork so the hero copy is reachable without scrolling on a laptop. */
  .hero-art img {
    width: 100%;
    max-height: min(52vh, 30rem);
    object-fit: contain;
  }
  .hero-lead {
    margin-block-start: clamp(1.5rem, 3.5vw, 2.5rem);
    max-width: 46ch;
  }
  .hero-copy {
    margin-block-start: clamp(1.25rem, 3vw, 2rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
  }
  @media (max-width: 860px) { .hero-copy { grid-template-columns: 1fr; } }
  /* Their one-line statement of what the business is. */
  .claim {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--electric);
    margin: 0;
  }

  .acc { color: var(--electric); }

  .twocol {
    margin-block-start: var(--s3);
    display: grid;
    gap: var(--s3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .trio {
    margin-block-start: var(--s4);
    display: grid;
    gap: var(--s2);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .gal { display: grid; gap: var(--s2); grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); }
</style>
