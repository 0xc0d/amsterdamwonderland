  { src: wOrangePortrait,    alt: nl ? "Portret in oranje en blauw" : "Portrait in orange and blue" },
  { src: food,               alt: nl ? "Fruit en groente klaargemaakt voor een workshop" : "Fruit and vegetables prepared for a workshop" },
  { src: wPaintingsFloor,    alt: nl ? "Geschilderde portretten uitgelegd op de vloer" : "Painted portraits laid out on the floor" },
  { src: wYellowFigure,      alt: nl ? "Figuur in geel" : "Figure in yellow" },
  { src: wStudioWide,        alt: nl ? "Overzicht van het atelier tijdens een sessie" : "The atelier during a session" },
  { src: wRedBluePortrait,   alt: nl ? "Portret in rood en blauw" : "Portrait in red and blue" },
