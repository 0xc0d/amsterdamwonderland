  { src: wOchreBaldPortrait,    alt: nl ? "Portret in oker en houtskool" : "Portrait in ochre and charcoal" },
  { src: wHoodedPortrait,       alt: nl ? "Portret met capuchon in houtskool en pastel" : "Hooded portrait in charcoal and pastel" },
  { src: wBeardedPortrait,      alt: nl ? "Portret met baard in houtskool" : "Bearded portrait in charcoal" },
];

---

<Base
  locale={locale}
  path="/gallery"
  title={d.gallery.metaTitle}
  description={d.gallery.metaDescription}
  pageType="ImageGallery"
  crumbs={[{ name: d.nav.gallery }]}
>
  <section class="shell head">
    <h1 class="display-lg">{d.gallery.title}</h1>
    <p class="lead">{d.gallery.lead}</p>
    <div class="intro prose">
      <p>{d.gallery.bodyA}</p>
      <p>{d.gallery.bodyB}</p>
    </div>
  </section>

  <section class="shell section--tight">
    <div class="mosaic">
      {items.map((it) => (
        <figure class="cell">
          <Image src={it.src} alt={it.alt} widths={[400, 800, 1400]}
                 sizes="(max-width: 900px) 50vw, 33vw" loading="lazy" />
        </figure>
      ))}
    </div>
    <p class="small muted note">{d.gallery.note}</p>
  </section>

  <BookingBar locale={locale} />
</Base>

<style>
  .head { padding-block-start: clamp(2rem, 6vw, 4rem); display: grid; gap: var(--s2); }
  /* Two columns so the added prose does not push the photographs a screen down.
     The lead is serif and short; this is body copy and sits beside it. */
  .intro { max-width: 58ch; }
  @media (min-width: 1000px) {
    .head { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--s5); }
    .head h1, .head .eyebrow { grid-column: 1 / -1; }
    .intro { margin-block-start: 0; }
  }
  .acc { color: var(--electric); }

  /* Masonry via columns: every photo keeps its own aspect ratio, nothing is
     cropped, and there are no holes to backfill. Reading order is per-column,
     which is fine for a gallery. */
  .mosaic { column-count: 3; column-gap: var(--s2); }
  .cell {
    margin: 0 0 var(--s2);
    break-inside: avoid;
    border: var(--rule) solid var(--line);
    overflow: hidden;
  }
  .cell img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform .4s ease;
  }
  .cell:hover img { transform: scale(1.03); }

  @media (max-width: 900px) { .mosaic { column-count: 2; } }
  /* Deliberately stays at 2 on phones: one column made the page 18,000px long. */
  @media (max-width: 520px) { .mosaic { column-count: 2; column-gap: 0.5rem; } }

  .note { margin-block-start: var(--s3); }
</style>
