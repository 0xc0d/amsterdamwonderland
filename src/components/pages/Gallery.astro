  { src: mPrintedPortrait,   alt: nl ? "Portret gedrukt op stof" : "Portrait printed on fabric" },
  { src: wHandsDrawing,      alt: nl ? "Handen aan het tekenen aan een portret" : "Hands working on a portrait" },
