  { src: wPinkPair,          alt: nl ? "Twee werken in roze en blauw" : "Two works in pink and blue" },
  { src: wDrawingOverhead,   alt: nl ? "Deelnemer aan het tekenen, van bovenaf" : "A participant drawing, seen from above" },
